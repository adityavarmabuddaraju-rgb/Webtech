<!DOCTYPE html>
<html>
<head>
    <title>Student Management System</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #eef2f7;
            display: flex;
            justify-content: center;
            padding-top: 40px;
        }

        .card {
            background: #ffffff;
            width: 750px;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        h2 {
            text-align: center;
            margin-bottom: 20px;
        }

        .form-row {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        input {
            flex: 1;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        button {
            padding: 8px 14px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }

        .add-btn {
            background: #28a745;
            color: white;
        }

        .edit-btn {
            background: #ffc107;
        }

        .delete-btn {
            background: #dc3545;
            color: white;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            padding: 8px;
            border: 1px solid #ddd;
            text-align: center;
        }

        th {
            background: #007bff;
            color: white;
        }

        .success {
            color: green;
            margin-bottom: 10px;
        }

        .error {
            color: red;
            margin-bottom: 10px;
        }
    </style>
</head>

<body>

<div class="card">

    <h2>Student Management System</h2>

    <div id="message"></div>

    <form id="studentForm">
        <div class="form-row">
            <input type="text" id="id" placeholder="Student ID" required>
            <input type="text" id="name" placeholder="Name" required>
            <input type="text" id="department" placeholder="Department" required>
            <input type="number" id="marks" placeholder="Marks (0-100)" min="0" max="100" required>
        </div>
        <button type="submit" class="add-btn" id="submitBtn">Add Student</button>
    </form>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Department</th>
                <th>Marks</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="tableBody"></tbody>
    </table>

</div>

<script>

let students = [];
let editMode = false;

/* Utility: Show Message */
function showMessage(text, type) {
    const msg = document.getElementById("message");
    msg.className = type;
    msg.innerText = text;
    setTimeout(() => msg.innerText = "", 3000);
}

/* READ */
function fetchStudents() {
    return Promise.resolve({
        status: 200,
        json: () => Promise.resolve(students)
    });
}

function displayStudents() {
    fetchStudents()
        .then(res => {
            if (res.status !== 200) throw new Error();
            return res.json();
        })
        .then(data => {
            const body = document.getElementById("tableBody");
            body.innerHTML = "";

            data.forEach(student => {
                body.innerHTML += `
                    <tr>
                        <td>${student.id}</td>
                        <td>${student.name}</td>
                        <td>${student.department}</td>
                        <td>${student.marks}</td>
                        <td>
                            <button class="edit-btn" onclick="editStudent('${student.id}')">Edit</button>
                            <button class="delete-btn" onclick="deleteStudent('${student.id}')">Delete</button>
                        </td>
                    </tr>
                `;
            });
        })
        .catch(() => showMessage("Internal Server Error (500)", "error"));
}

/* CREATE / UPDATE */
document.getElementById("studentForm").addEventListener("submit", function(e) {
    e.preventDefault();

    const id = idInput.value.trim();
    const name = nameInput.value.trim();
    const department = deptInput.value.trim();
    const marks = marksInput.value.trim();

    if (marks < 0 || marks > 100) {
        showMessage("Marks must be between 0 and 100 (400)", "error");
        return;
    }

    const data = { id, name, department, marks };

    if (editMode) {
        updateStudent(data);
    } else {
        createStudent(data);
    }
});

/* CREATE */
function createStudent(data) {
    if (students.find(s => s.id === data.id)) {
        showMessage("Student Already Exists (500)", "error");
        return;
    }

    students.push(data);
    showMessage("Student Added Successfully (200)", "success");
    resetForm();
    displayStudents();
}

/* UPDATE */
function updateStudent(data) {
    const student = students.find(s => s.id === data.id);

    if (!student) {
        showMessage("Student Not Found (404)", "error");
        return;
    }

    Object.assign(student, data);

    showMessage("Student Updated Successfully (200)", "success");

    editMode = false;
    submitBtn.innerText = "Add Student";
    idInput.disabled = false;

    resetForm();
    displayStudents();
}

/* EDIT */
function editStudent(id) {
    const student = students.find(s => s.id === id);

    if (!student) {
        showMessage("Student Not Found (404)", "error");
        return;
    }

    idInput.value = student.id;
    nameInput.value = student.name;
    deptInput.value = student.department;
    marksInput.value = student.marks;

    idInput.disabled = true;
    submitBtn.innerText = "Update Student";
    editMode = true;
}

/* DELETE */
function deleteStudent(id) {
    if (!confirm("Are you sure you want to delete this student?")) return;

    const index = students.findIndex(s => s.id === id);

    if (index === -1) {
        showMessage("Student Not Found (404)", "error");
        return;
    }

    students.splice(index, 1);
    showMessage("Student Deleted Successfully (200)", "success");
    displayStudents();
}

/* Reset */
function resetForm() {
    document.getElementById("studentForm").reset();
}

/* DOM References */
const idInput = document.getElementById("id");
const nameInput = document.getElementById("name");
const deptInput = document.getElementById("department");
const marksInput = document.getElementById("marks");
const submitBtn = document.getElementById("submitBtn");

displayStudents();

</script>

</body>
</html>
